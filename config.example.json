{
  "transport": "weixin",
  "backend": "codex",
  "workspace": {
    "id": "default",
    "path": "/absolute/path/to/home/workspace/test-repository"
  },
  "stateRoot": "/absolute/path/to/local-agent-state",
  "local": {
    "actorId": "operator"
  },
  "agent": {
    "command": "/absolute/path/to/codex",
    "args": [],
    "env": {
      "HOME": "/absolute/path/to/dedicated-agent-home"
    },
    "passEnv": [],
    "isolation": "native"
  },
  "codex": {
    "home": "/absolute/path/to/dedicated-codex-home",
    "sandbox": "read-only",
    "networkAccess": false,
    "model": "gpt-6-sol",
    "reasoning": "high",
    "contextWindowTokens": 828400
  },
  "models": {
    "daily": {
      "model": "gpt-6-sol",
      "reasoning": "high",
      "contextWindowTokens": 828400
    }
  },
  "orchestration": {
    "mode": "hierarchical",
    "controllerRuntime": {
      "kind": "codex-app-server",
      "transport": "stdio",
      "command": "/absolute/path/to/probed-codex-controller",
      "home": "/absolute/path/to/dedicated-codex-home",
      "workRoot": "/absolute/path/to/local-agent-state/controllers",
      "requireCapabilityProbe": true,
      "nativeAutoCompaction": "disabled"
    },
    "bridge": {
      "modelProfile": "daily"
    },
    "route": {
      "inheritModelFrom": "bridge",
      "initialization": "lazy"
    },
    "business": {
      "defaultModelProfile": "daily"
    },
    "rotation": {
      "thresholdNumerator": 4,
      "thresholdDenominator": 5,
      "usageSource": "runtime-only",
      "mode": "new-session-with-handoff"
    },
    "query": {
      "mode": "verbatim",
      "injectHistoricalContext": false
    },
    "answers": {
      "root": "/absolute/path/to/local-agent-state/artifacts",
      "maxOriginalBytes": 16777216,
      "shortAnswerMaxChars": 1200,
      "recapMaxChars": 1000,
      "recapModelProfile": "daily",
      "bridgeCanReadOriginal": false
    },
    "history": {
      "defaultInteractionLimit": 30,
      "defaultSessionLimit": 10,
      "maxOriginalPageBytes": 16384
    },
    "limits": {
      "maxControllerDecisionsPerRequest": 12,
      "controllerDecisionTimeoutMs": 180000,
      "passiveChildWaitUsesBusinessDeadline": true,
      "businessWorkers": 1
    }
  },
  "routing": {
    "roots": [
      {
        "id": "workspace",
        "path": "/absolute/path/to/home/workspace",
        "profile": "default"
      }
    ],
    "profiles": [
      {
        "id": "default",
        "version": "1"
      }
    ],
    "workspaces": [
      {
        "id": "default",
        "path": "/absolute/path/to/home/workspace/test-repository",
        "profile": "default",
        "aliases": []
      }
    ]
  }
}
