{
  "transport": "local",
  "backend": "codex",
  "workspace": {
    "id": "bridge",
    "path": "/absolute/path/to/home/workspace/bridge"
  },
  "stateRoot": "/absolute/path/to/private/bridge-state",
  "local": {
    "actorId": "operator"
  },
  "agent": {
    "command": "/absolute/path/to/codex",
    "env": {
      "HOME": "/absolute/path/to/private/agent-home"
    },
    "sessionRoot": "/absolute/path/to/private/pi-sessions",
    "passEnv": [],
    "isolation": "native"
  },
  "codex": {
    "home": "/absolute/path/to/private/codex-home",
    "sandbox": "read-only",
    "networkAccess": false,
    "model": "gpt-6-sol",
    "reasoning": "high",
    "contextWindowTokens": 828400
  },
  "routing": {
    "fallbackWorkspace": "temp",
    "roots": [
      {
        "id": "projects",
        "path": "/absolute/path/to/home/workspace",
        "profile": "codex-read"
      }
    ],
    "profiles": [
      {
        "id": "codex-read",
        "version": "1",
        "codex": {}
      }
    ],
    "workspaces": [
      {
        "id": "temp",
        "path": "/absolute/path/to/home/workspace/temp",
        "profile": "codex-read",
        "aliases": [],
        "description": "无项目归属的日常问答与图片会话"
      },
      {
        "id": "bridge",
        "path": "/absolute/path/to/home/workspace/bridge",
        "profile": "codex-read",
        "aliases": [
          "微信桥"
        ],
        "description": "个人微信与本地 Agent 桥接"
      },
      {
        "id": "video",
        "path": "/absolute/path/to/home/workspace/video",
        "profile": "codex-read",
        "aliases": [
          "配音",
          "视频项目"
        ],
        "description": "视频配音项目"
      }
    ],
    "history": true
  },
  "models": {
    "daily": {
      "model": "gpt-6-sol",
      "reasoning": "high",
      "contextWindowTokens": 828400
    }
  },
  "orchestration": {
    "mode": "hierarchical",
    "controllerRuntime": {
      "kind": "codex-app-server",
      "transport": "stdio",
      "command": "/absolute/path/to/probed-codex-controller",
      "home": "/absolute/path/to/dedicated-codex-home",
      "workRoot": "/absolute/path/to/private/bridge-state/controllers",
      "requireCapabilityProbe": true,
      "nativeAutoCompaction": "disabled"
    },
    "bridge": {
      "modelProfile": "daily"
    },
    "route": {
      "inheritModelFrom": "bridge",
      "initialization": "lazy"
    },
    "business": {
      "defaultModelProfile": "daily"
    },
    "rotation": {
      "thresholdNumerator": 4,
      "thresholdDenominator": 5,
      "usageSource": "runtime-only",
      "mode": "new-session-with-handoff"
    },
    "query": {
      "mode": "verbatim",
      "injectHistoricalContext": false
    },
    "answers": {
      "root": "/absolute/path/to/private/bridge-state/artifacts",
      "maxOriginalBytes": 16777216,
      "shortAnswerMaxChars": 1200,
      "recapMaxChars": 1000,
      "recapModelProfile": "daily",
      "bridgeCanReadOriginal": false
    },
    "history": {
      "defaultInteractionLimit": 30,
      "defaultSessionLimit": 10,
      "maxOriginalPageBytes": 16384
    },
    "limits": {
      "maxControllerDecisionsPerRequest": 12,
      "controllerDecisionTimeoutMs": 180000,
      "passiveChildWaitUsesBusinessDeadline": true,
      "businessWorkers": 1
    }
  }
}
