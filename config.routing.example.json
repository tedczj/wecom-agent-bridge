{
  "transport": "local",
  "backend": "codex",
  "workspace": { "id": "bridge", "path": "/absolute/path/to/projects/bridge" },
  "stateRoot": "/absolute/path/to/private/bridge-state",
  "local": { "actorId": "operator" },
  "agent": {
    "command": "/absolute/path/to/codex",
    "env": { "HOME": "/absolute/path/to/private/agent-home" },
    "sessionRoot": "/absolute/path/to/private/pi-sessions",
    "passEnv": [],
    "isolation": "native"
  },
  "codex": {
    "home": "/absolute/path/to/private/codex-home",
    "sandbox": "read-only",
    "networkAccess": false
  },
  "routing": {
    "roots": [ { "id": "projects", "path": "/absolute/path/to/projects", "profile": "codex-read" } ],
    "profiles": [ { "id": "codex-read", "version": "1", "codex": { "reasoning": "medium" } } ],
    "workspaces": [
      { "id": "bridge", "path": "/absolute/path/to/projects/bridge", "profile": "codex-read", "aliases": ["微信桥"], "description": "个人微信与本地 Agent 桥接" },
      { "id": "video", "path": "/absolute/path/to/projects/video", "profile": "codex-read", "aliases": ["配音", "视频项目"], "description": "视频配音项目" }
    ],
    "history": true
  }
}
