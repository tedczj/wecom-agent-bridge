{
  "transport": "local",
  "backend": "codex",
  "workspace": {
    "id": "bridge-fixture",
    "path": "/ABSOLUTE/PATH/live-fixture/projects/wecom-agent-bridge"
  },
  "stateRoot": "/ABSOLUTE/PATH/live-fixture/state",
  "local": {
    "actorId": "operator-live-fixture"
  },
  "agent": {
    "command": "/ABSOLUTE/PATH/codex",
    "env": {
      "HOME": "/ABSOLUTE/PATH/dedicated-agent-home"
    },
    "sessionRoot": "/ABSOLUTE/PATH/live-fixture/pi-sessions",
    "passEnv": [],
    "isolation": "native"
  },
  "codex": {
    "home": "/ABSOLUTE/PATH/dedicated-codex-home",
    "sandbox": "read-only",
    "networkAccess": false
  },
  "models": {
    "daily": {
      "model": "gpt-5.6-terra",
      "reasoning": "high",
      "contextWindowTokens": 1000000
    }
  },
  "routing": {
    "roots": [
      {
        "id": "projects",
        "path": "/ABSOLUTE/PATH/live-fixture/projects",
        "profile": "codex-read"
      }
    ],
    "profiles": [
      {
        "id": "codex-read",
        "version": "1",
        "codex": {
          "sandbox": "read-only",
          "networkAccess": false
        }
      }
    ],
    "workspaces": [
      {
        "id": "bridge-fixture",
        "path": "/ABSOLUTE/PATH/live-fixture/projects/wecom-agent-bridge",
        "profile": "codex-read",
        "aliases": [
          "微信桥测试项目"
        ],
        "description": "合成测试目录，不是真实业务仓库"
      }
    ],
    "history": true
  },
  "orchestration": {
    "mode": "hierarchical",
    "controllerRuntime": {
      "kind": "codex-app-server",
      "transport": "stdio",
      "command": "/ABSOLUTE/PATH/codex",
      "home": "/ABSOLUTE/PATH/dedicated-codex-home",
      "workRoot": "/ABSOLUTE/PATH/live-fixture/state/controllers",
      "requireCapabilityProbe": true,
      "nativeAutoCompaction": "disabled"
    },
    "bridge": {
      "modelProfile": "daily"
    },
    "route": {
      "inheritModelFrom": "bridge",
      "initialization": "lazy"
    },
    "business": {
      "defaultModelProfile": "daily"
    },
    "rotation": {
      "thresholdNumerator": 4,
      "thresholdDenominator": 5,
      "usageSource": "runtime-only",
      "mode": "new-session-with-handoff"
    },
    "query": {
      "mode": "verbatim",
      "injectHistoricalContext": false
    },
    "answers": {
      "root": "/ABSOLUTE/PATH/live-fixture/state/artifacts",
      "maxOriginalBytes": 16777216,
      "shortAnswerMaxChars": 1200,
      "recapMaxChars": 1000,
      "recapModelProfile": "daily",
      "bridgeCanReadOriginal": false
    },
    "history": {
      "defaultInteractionLimit": 30,
      "defaultSessionLimit": 10,
      "maxOriginalPageBytes": 16384
    },
    "limits": {
      "maxControllerDecisionsPerRequest": 12,
      "controllerDecisionTimeoutMs": 90000,
      "passiveChildWaitUsesBusinessDeadline": true,
      "businessWorkers": 1
    }
  }
}
