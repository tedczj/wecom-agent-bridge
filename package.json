{
  "name": "local-agent-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Durable personal Weixin and local JSONL bridge for Codex CLI and Pi RPC",
  "engines": {
    "node": ">=22.16.0 <23 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "rm -rf dist && npm run build && node --test dist/tests/unit/*.test.js dist/tests/contract/*.test.js dist/tests/e2e/*.test.js",
    "test:unit": "npm run build && node --test dist/tests/unit/*.test.js",
    "test:contract": "npm run build && node --test dist/tests/contract/*.test.js",
    "test:e2e": "npm run build && node --test dist/tests/e2e/*.test.js",
    "check": "npm run typecheck && npm test",
    "bridge": "npm run build --silent && node dist/src/cli.js",
    "smoke:codex": "npm run build --silent && node dist/scripts/smoke-agent.js codex",
    "smoke:pi": "npm run build --silent && node dist/scripts/smoke-agent.js pi",
    "smoke:maintenance": "npm run build --silent && node dist/scripts/smoke-maintenance.js",
    "probe:controller": "npm run build --silent && node dist/scripts/probe-controller.js",
    "test:live": "npm run build --silent && node dist/scripts/live-orchestration.js",
    "smoke:progress": "npm run build --silent && node dist/scripts/smoke-progress.js"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0",
    "sharp": "0.34.1"
  },
  "devDependencies": {
    "@types/node": "22.15.33",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "5.8.3"
  }
}
