{
  "name": "wecom-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, durable WeCom-to-Pi RPC bridge",
  "engines": {
    "node": ">=22.16.0 <23 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/unit/*.test.js dist/tests/contract/*.test.js dist/tests/e2e/*.test.js",
    "test:unit": "npm run build && node --test dist/tests/unit/*.test.js",
    "test:contract": "npm run build && node --test dist/tests/contract/*.test.js",
    "test:e2e": "npm run build && node --test dist/tests/e2e/*.test.js",
    "check": "npm run typecheck && npm test",
    "bridge": "npm run build --silent && node dist/src/cli.js",
    "dev": "npm run build --silent && node dist/src/main.js",
    "smoke:wecom": "npm run build --silent && node dist/scripts/smoke-wecom.js",
    "smoke:pi": "npm run build --silent && node dist/scripts/smoke-pi.js"
  },
  "dependencies": {
    "sharp": "0.34.1",
    "@wecom/aibot-node-sdk": "1.0.6"
  },
  "devDependencies": {
    "@types/node": "22.15.33",
    "typescript": "5.8.3"
  }
}
