diff --git a/codex-rs/core/tests/suite/bridge_controller.rs b/codex-rs/core/tests/suite/bridge_controller.rs
new file mode 100644
index 0000000..b473823
--- /dev/null
+++ b/codex-rs/core/tests/suite/bridge_controller.rs
@@ -0,0 +1,124 @@
+use anyhow::Result;
+use codex_core::StartThreadOptions;
+use codex_core::TurnInputRequest;
+use codex_features::Feature;
+use codex_protocol::dynamic_tools::DynamicToolFunctionSpec;
+use codex_protocol::dynamic_tools::DynamicToolSpec;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::user_input::UserInput;
+use core_test_support::responses;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event;
+use core_test_support::wait_for_event_match;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn bridge_controller_only_sends_dynamic_tools_and_reports_the_exact_inventory() -> Result<()>
+{
+    let server = responses::start_mock_server().await;
+    let mock = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_assistant_message("message", "done"),
+            responses::ev_completed("response"),
+        ]),
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config
+                .features
+                .enable(Feature::BridgeControllerOnly)
+                .unwrap();
+            config.features.enable(Feature::ShellTool).unwrap();
+            config.features.enable(Feature::ViewImage).unwrap();
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    let started = test
+        .thread_manager
+        .start_thread(StartThreadOptions {
+            dynamic_tools: vec![DynamicToolSpec::Function(DynamicToolFunctionSpec {
+                name: "bridge_read".to_string(),
+                description: "Read host metadata".to_string(),
+                input_schema: json!({"type":"object","properties":{},"additionalProperties":false}),
+                defer_loading: false,
+            })],
+            ..StartThreadOptions::new(test.config.clone())
+        })
+        .await?;
+    started
+        .thread
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Only answer done".to_string(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let policy = wait_for_event_match(&started.thread, |event| match event {
+        EventMsg::Warning(warning) => warning
+            .message
+            .strip_prefix("BRIDGE_CONTROLLER_POLICY_V1:")
+            .map(str::to_owned),
+        _ => None,
+    })
+    .await;
+    wait_for_event(&started.thread, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let policy: Value = serde_json::from_str(&policy)?;
+    let body = mock.single_request().body_json();
+    assert_eq!(policy["tools"], body["tools"]);
+    assert_eq!(policy["nativeAutoCompaction"], "disabled");
+    assert_eq!(policy["dynamicToolsOnly"], true);
+    let names = body["tools"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|tool| tool["name"].as_str().unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(names, vec!["bridge_read"]);
+    started.thread.shutdown_and_wait().await?;
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn bridge_controller_rejects_automatic_compaction_without_a_compaction_request() -> Result<()>
+{
+    let server = responses::start_mock_server().await;
+    let mock = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_assistant_message("message", "done"),
+            responses::ev_completed_with_tokens("response", /*total_tokens*/ 70_000),
+        ]),
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config
+                .features
+                .enable(Feature::BridgeControllerOnly)
+                .unwrap();
+            config.model_auto_compact_token_limit = Some(50_000);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_text_turn("first").await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "second".to_string(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let error = wait_for_event_match(&test.codex, |event| match event {
+        EventMsg::Error(error) => Some(error.message.clone()),
+        _ => None,
+    })
+    .await;
+    assert!(error.contains("BRIDGE_NATIVE_AUTO_COMPACTION_DISABLED"));
+    assert_eq!(mock.requests().len(), 1);
+    Ok(())
+}
